{
  "compilerOptions": {
    "checkJs": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.js", "test/**/*.js", "scripts/**/*.js"]
}
