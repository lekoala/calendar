{
  "name": "@lekoala/calendar",
  "version": "0.0.0-prototype",
  "description": "Framework-agnostic Temporal calendar and resource scheduler Web Component",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.0",
  "sideEffects": [
    "./src/calendar.css",
    "./src/define.js"
  ],
  "exports": {
    ".": "./src/index.js",
    "./define": "./src/define.js",
    "./calendar.css": "./src/calendar.css"
  },
  "scripts": {
    "dev": "bun scripts/dev.js",
    "audit:page": "bun scripts/audit-page.js",
    "test": "bun test test/core",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "lint": "biome check src test scripts",
    "typecheck": "tsc -p jsconfig.json",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "peerDependencies": {
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.4.1",
    "temporal-polyfill": "^1.0.4",
    "typescript": "^7"
  }
}
